<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox fx:id="ListBox" spacing="15.0" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladores.ListaDeActividadesController">

    <padding>
        <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
    </padding>

     <Text styleClass="subtitle" text="Actividades" />

    <!-- ================= TOOLBAR ================= -->

    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Button fx:id="btnDelete" onAction="#btnDelete_Action" styleClass="danger-button" text="Eliminar" />

        <Button fx:id="btnCancelDelete" onAction="#btnCancelDelete_Action" styleClass="secondary-button" text="Cancelar" visible="false" />

        <Button fx:id="btnConfirmDelete" onAction="#btnConfirmDelete_Action" styleClass="danger-button" text="Confirmar" visible="false" />

        <Button fx:id="btnOpen" onAction="#accederActividad" styleClass="primary-button" text="Acceder" />

    </HBox>

    <!-- ================= LISTA ================= -->

    <ListView fx:id="activitiesListView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS" />

    <!-- ================= CSS ================= -->

    <stylesheets>
        <URL value="@../EstilosVariados/estilos.css" />
        <URL value="@../EstilosVariados/vistalistadeactividades.css" />
    </stylesheets>

</VBox>
