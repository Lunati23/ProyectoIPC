<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox fx:id="ListBox" spacing="12" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladores.ListaDeActividadesController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- ================= TOOLBAR ================= -->
    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Text styleClass="highlight-label" text="Actividades" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnDeleteMode" styleClass="danger-button" text="Eliminar" />

        <Button fx:id="btnCancelDelete" styleClass="secondary-button" text="Cancelar" visible="false" />

        <Button fx:id="btnConfirmDelete" styleClass="primary-button" text="Eliminar seleccionadas" visible="false" />

    </HBox>

    <!-- ================= LISTA ================= -->
    <!-- Reemplaza la sección de LISTA con esto: -->
    <ListView fx:id="activitiesListView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS" />

    <!-- CSS LOCAL -->
    <stylesheets>
        <URL value="@../EstilosVariados/estilos.css" />
        <URL value="@../EstilosVariados/vistalistadeactividades.css" />
    </stylesheets>

</VBox>
