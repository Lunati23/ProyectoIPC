<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="350.0" prefWidth="400.0" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladores.AnadirAnotacionController">
   <children>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="16.0" styleClass="card" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER">
               <children>
                  <Label styleClass="subtitle" text="Nueva Anotación" />
               </children>
               <VBox.margin>
                  <Insets bottom="4.0" />
               </VBox.margin>
            </HBox>
            
            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Descripción*:" />
                  <TextField fx:id="descripcion" maxWidth="1.7976931348623157E308" promptText="Ej: Zona peligrosa..." />
               </children>
            </VBox>
            
            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Color*:" />
                  <ColorPicker fx:id="colorPicker" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="color-picker-custom" />
               </children>
            </VBox>
            
            <VBox VBox.vgrow="ALWAYS" />
            
            <HBox alignment="BOTTOM_RIGHT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#accionCancelar" styleClass="secondary-button" text="Cancelar" />
                  <Button fx:id="guardar" mnemonicParsing="false" onAction="#accionAceptar" styleClass="button" text="Guardar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <stylesheets>
      <URL value="@../EstilosVariados/estilos.css" />
      <URL value="@../EstilosVariados/anotacion.css" />
   </stylesheets>
</AnchorPane>
