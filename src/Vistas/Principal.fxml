<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane stylesheets="@../EstilosVariados/estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="column-header">

            <!-- IZQUIERDA: salir + logo + título -->
            <Button fx:id="btnSalir" text="Salir" />

            <ImageView fx:id="imgLogo" fitHeight="30" fitWidth="30" preserveRatio="true">
            <image>
               <Image url="@../logos/logo_montana.png" />
            </image></ImageView>

            <Text styleClass="title" text="SaforRun" />

            <!-- separador flexible -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- DERECHA: usuario + historial -->
            <Button fx:id="btnUsuario">
            <graphic>
               <ImageView fx:id="imgLogo1" fitHeight="30" fitWidth="30" preserveRatio="true">
                  <image>
                     <Image url="@../logos/logo_usuario.png" />
                  </image>
               </ImageView>
            </graphic></Button>
            <Button fx:id="btnHistorial">
            <graphic>
               <ImageView fx:id="imgLogo11" fitHeight="30" fitWidth="30" preserveRatio="true">
                  <image>
                     <Image url="@../logos/logo_usuario.png" />
                  </image>
               </ImageView>
            </graphic></Button>

        </HBox>
    </top>

    <!-- ================= CENTER (VACÍO) ================= -->
    <center>
        <VBox />
    </center>

    <!-- ================= BOTTOM BUTTONS ================= -->
    <bottom>
        <HBox alignment="CENTER" spacing="40" styleClass="bottom-bar">

            <!-- BOTÓN: Añadir mapa -->
            <VBox alignment="CENTER">
                <ImageView fx:id="imgMapa" fitHeight="80" fitWidth="80" preserveRatio="true" />
                <Text text="Añadir mapa" />
            </VBox>

            <!-- BOTÓN: GPX -->
            <VBox alignment="CENTER">
                <ImageView fx:id="imgGpx" fitHeight="80" fitWidth="80" preserveRatio="true" />
                <Text text="Añadir GPX" />
            </VBox>

            <!-- BOTÓN: actividades -->
            <VBox alignment="CENTER">
                <ImageView fx:id="imgActividades" fitHeight="80" fitWidth="80" preserveRatio="true" />
                <Text text="Actividades" />
            </VBox>

        </HBox>
    </bottom>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>

</BorderPane>
