<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../EstilosVariados/estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladores.AcumuladosController">

    <children>

        <VBox spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <padding>
                <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
            </padding>

            <children>

                <VBox spacing="8.0">

                    <children>

                        <Text styleClass="subtitle" text="Acumulado mensual" />

                        <Label styleClass="small-text" text="Resumen total de actividades del mes actual" />

                    </children>

                </VBox>

                <GridPane hgap="25.0" vgap="25.0" VBox.vgrow="ALWAYS">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />

                    </columnConstraints>

                    <children>

                        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="0" GridPane.rowIndex="0">

                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>

                            <children>

                                <Label text="Distancia total" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">

                                    <children>

                                        <Text fx:id="txtDistancia" styleClass="highlight-label" text="0.0 km" />

                                        <Region HBox.hgrow="ALWAYS" />

                                    </children>

                                </HBox>

                            </children>

                        </VBox>

                        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="0">

                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>

                            <children>

                                <Label text="Tiempo total" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">

                                    <children>

                                        <Text fx:id="txtTiempo" styleClass="highlight-label" text="00:00:00" />

                                        <Region HBox.hgrow="ALWAYS" />

                                    </children>

                                </HBox>

                            </children>

                        </VBox>

                        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="0" GridPane.rowIndex="1">

                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>

                            <children>

                                <Label text="Ascenso acumulado" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">

                                    <children>

                                        <Text fx:id="txtAscenso" styleClass="highlight-label" text="0 m" />

                                        <Region HBox.hgrow="ALWAYS" />

                                    </children>

                                </HBox>

                            </children>

                        </VBox>

                        <VBox spacing="12.0" styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="1">

                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>

                            <children>

                                <Label text="Descenso acumulado" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">

                                    <children>

                                        <Text fx:id="txtDescenso" styleClass="highlight-label" text="0 m" />

                                        <Region HBox.hgrow="ALWAYS" />

                                    </children>

                                </HBox>

                            </children>

                        </VBox>

                    </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>

            </children>

        </VBox>

    </children>

</AnchorPane>
